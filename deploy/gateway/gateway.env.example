# Passerelle d'entreprise FounderOS (G7) — variables du conteneur (docker-compose.yml).

# ── Le relais ────────────────────────────────────────────────────────────────
# L'adresse de FounderOS et le jeton du relais (Ressources → Outils internes → Relais).
FOUNDEROS_URL=https://xxxxxxxx.supabase.co
RELAY_TOKEN=fosr_...
# Outils joignables, refus par défaut. Le serveur MCP de la passerelle y est ajouté d'office.
RELAY_ALLOWED_HOSTS=
RELAY_ALLOWED_BINARIES=

# ── Les serveurs MCP (vide : relais seul) ────────────────────────────────────
GATEWAY_MCP_SERVERS=openshift
GATEWAY_MCP_PORT=8443
MCP_CLUSTER=prd
# Jeton tournant : la graine dans seed.txt (elle ne quitte pas la machine), le premier jeton
# collé une fois dans FounderOS ; ensuite le serveur livre lui-même chaque nouveau jeton
# à FOUNDEROS_URL.
#   docker run --rm -v "$PWD:/w" <image> node mcp/dist/token-cli.js seed --file /w/seed.txt
MCP_TOKEN_ROLES=ai-ops-reader
MCP_TOKEN_PERIOD=24h
# Identifiants des outils (credential { "type": "env", "name": "K8S_TOKEN" } dans mcp-config.json) :
K8S_TOKEN=
# Jetons d'approbation de FounderOS (actions sensibles) :
APPROVAL_ISSUER=
APPROVAL_JWKS_URL=
