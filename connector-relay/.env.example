# URL de votre projet FounderOS (Supabase)
FOUNDEROS_URL=https://xxxxxxxx.supabase.co
# Jeton créé dans FounderOS : Ressources → Outils internes → Relais (montré une seule fois)
RELAY_TOKEN=fosr_...

# Ce que le relais a le droit de joindre. Refus par défaut : rien n'est joignable si vide.
RELAY_ALLOWED_HOSTS=argocd.interne.exemple,vault.interne.exemple:8200,*.monitoring.svc.cluster.local
# CLI autorisées (opérations « commande »). Vide : aucune.
RELAY_ALLOWED_BINARIES=
# RELAY_DENIED_SUBCOMMANDS=helm:uninstall,helm:delete,kubectl:delete,kubectl:exec
# RELAY_CA_FILE=/etc/ssl/interne/ca.pem
# RELAY_CONCURRENCY=4
# RELAY_HEALTH_PORT=8080

# Secrets détenus par le relais (profils « relais » côté FounderOS : env:ARGOCD_TOKEN)
# ARGOCD_TOKEN=
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
