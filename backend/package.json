{
  "name": "founderos-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:self": "tsx watch --env-file=.env.self src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "eval": "tsx src/evals/run.ts",
    "platform": "tsx src/platform/cli.ts"
  },
  "dependencies": {
    "@composio/core": "0.14.0",
    "@electric-sql/pglite": "^0.3.16",
    "@opencode/plugin": "2.3.2",
    "@opencode/sdk": "2.3.2",
    "@supabase/supabase-js": "2.45.4",
    "@zip.js/zip.js": "2.7.45",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "effect": "4.1.0",
    "express": "^5.2.1",
    "jose": "5.9.6",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "undici": "^7.30.0",
    "unpdf": "0.12.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2"
  }
}
