    "express": "^5.2.1",
    "jose": "5.9.6",
    "undici": "^7.30.0",
    "unpdf": "0.12.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2"
  }
