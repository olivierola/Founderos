# Plateforme auto-hébergée : ce backend sert lui-même la base (API PostgREST),
# l'auth (GoTrue), le storage et le realtime, sur un PostgreSQL à vous.
#
#   cp .env.self.example .env.self
#   npm run dev:self                      → http://localhost:8787
#   npm run platform -- keys              → les variables à mettre dans le .env du front
#
# Les secrets des fonctions (LLM, Composio, Stripe…) se mettent ici comme dans
# .env : copiez la section « Secrets des fonctions » de .env.example.

PLATFORM=self

# PostgreSQL : postgres://utilisateur:mot-de-passe@hôte:5432/base (le rôle doit
# pouvoir créer des rôles et des schémas : propriétaire de la base, ou
# superutilisateur pour l'import), ou pglite://<dossier> — un PostgreSQL
# embarqué, sans rien installer, pour essayer et tester. pglite://memory : en
# mémoire, effacé à l'arrêt.
DATABASE_URL=pglite://./.data/pg

# Le secret qui signe les sessions et les clés d'API (32 caractères au moins).
# Le changer déconnecte tout le monde et change les clés du front.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# URL publique de ce backend : liens des e-mails, redirections OAuth, URL des
# fichiers publics, et l'adresse que les tâches planifiées appellent.
FUNCTIONS_URL=http://localhost:8787

# Appliquer le socle et les migrations au démarrage (dépôt complet). En
# conteneur : false, et le service « migrate » (deploy/migrations, PLATFORM=self).
PLATFORM_MIGRATE=true
# Tâches planifiées (ex-pg_cron) et requêtes sortantes (ex-pg_net). Avec
# plusieurs instances, toutes peuvent les garder : chaque passage est réservé.
PLATFORM_WORKERS=true
# Fichiers du storage (un volume en production).
STORAGE_DIR=./.data/storage
# Schémas exposés par /rest/v1.
PGRST_DB_SCHEMAS=public

# ── Harnais OpenCode (docs/harness-opencode) ─────────────────────────────────
# 1 : le moteur d'agent d'OpenCode tourne dans ce processus. Les agents marqués
# « opencode » l'utilisent, les autres gardent l'ancien moteur. 0 : désactivé.
HARNESS_OPENCODE=0
# Base d'exécution d'OpenCode et dossiers de travail des agents (un volume).
HARNESS_DIR=./.data/opencode
# Modèle par défaut des sessions, « fournisseur/modèle » (clé lue dans
# OPENROUTER_API_KEY pour openrouter). Vide : le défaut d'OpenCode.
HARNESS_MODEL=openrouter/nvidia/nemotron-3.5-super-vl:free
# L'outillage FounderOS par lots (docs/harness-opencode/03) ; 0 : les outils natifs d'OpenCode seuls.
# HARNESS_TOOLKIT=1

# ── Auth (mêmes noms que GoTrue : GOTRUE_… ou AUTH_…) ────────────────────────
# Où l'app vit : redirections après connexion, liens des e-mails.
GOTRUE_SITE_URL=http://localhost:5173
# Autres redirections permises (virgules, jokers *).
GOTRUE_URI_ALLOW_LIST=
GOTRUE_JWT_EXP=3600
GOTRUE_DISABLE_SIGNUP=false
# Sans moyen d'envoyer un e-mail, les comptes sont confirmés d'office (le lien
# est écrit dans la console). Avec SMTP ou Resend, défaut : confirmation par e-mail.
GOTRUE_MAILER_AUTOCONFIRM=
GOTRUE_PASSWORD_MIN_LENGTH=8
# E-mails : SMTP, sinon RESEND_API_KEY, sinon la console.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_SENDER=FounderOS <no-reply@example.com>

# Connexion par fournisseur (redirection à déclarer chez lui :
# <FUNCTIONS_URL>/auth/v1/callback). Les fournisseurs OIDC d'entreprise
# s'ajoutent à chaud depuis Administration → Authentification.
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_AZURE_CLIENT_ID=
GOTRUE_EXTERNAL_AZURE_SECRET=
# https://login.microsoftonline.com/<tenant>/v2.0
GOTRUE_EXTERNAL_AZURE_URL=
GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=
GOTRUE_EXTERNAL_GITHUB_SECRET=
# Apple : le secret est le JWT client (ES256) que génère votre compte Apple.
GOTRUE_EXTERNAL_APPLE_CLIENT_ID=
GOTRUE_EXTERNAL_APPLE_SECRET=

# ── Machine des équipes d agents (docs/team-machine.md) ──
# Le conteneur team-machine/compose.yaml écoute sur :8091. Le jeton est le même
# des deux côtés (32 caractères ou plus) ; scripts/start-local.mjs le reprend de
# team-machine/secret. Sans lui, seules les machines qui ont leur propre jeton répondent.
TEAM_MACHINE_URL=http://localhost:8091
TEAM_MACHINE_TOKEN=
