# ── Supabase (Project Settings → API) — obligatoires ─────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Recommandé : « JWT Secret » du projet. Sans lui, chaque JWT utilisateur HS256
# est vérifié par un appel à Supabase Auth (un aller-retour par requête).
SUPABASE_JWT_SECRET=

# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=8787
# Port de gestion : /metrics (appels MCP des agents, approbations PRD). 0 le
# désactive. À ne jamais exposer par une Route.
MGMT_PORT=9090
# URL publique de ce backend (ex. https://api.example.com). Sert aux appels
# entre fonctions et aux URL données aux tiers (webhooks, redirection OAuth).
# Vide : http://localhost:$PORT.
FUNCTIONS_URL=
# Nombre de proxys devant le serveur (1 sur Railway, Render ou Fly.io).
# Sert à lire la vraie IP du client pour le rate limiting.
TRUST_PROXY=1
# Vérification du JWT à la passerelle (src/shared/gateway.ts) :
#   production (défaut) — comme la passerelle Supabase aujourd'hui ;
#   strict — toutes les fonctions sauf les exceptions de supabase/config.toml (FOS-16).
GATEWAY_VERIFY_JWT=production

# ── Secrets des fonctions ────────────────────────────────────────────────────
# Les mêmes que dans Supabase → Edge Functions → Secrets. Une fonction dont la
# clé manque répond une erreur explicite ; les autres ne sont pas affectées.

# Application
APP_URL=
APP_BASE_URL=
APP_ORIGIN=
WIDGET_HOST=
DEFAULT_TIMEZONE=

# LLM
GROQ_API_KEY=
DEEPSEEK_API_KEY=
RUNPOD_API_KEY=
RUNPOD_VLLM_API_KEY=
TYPESAFE_API_KEY=
AGENT_MODEL_CHAT=
AGENT_MODEL_MISSION=
AGENT_MODEL_PLANNER=
E2E_AGENT_PROVIDER=
E2E_AGENT_MODEL=
LLM_GLOBAL_BLOCK=
# Paliers du routeur de modèles (_shared/model-router.ts)
AGENT_MODEL_LIGHT=
AGENT_MODEL_STANDARD=
AGENT_MODEL_HEAVY=
AGENT_MODEL_GROQ_LIGHT=
AGENT_MODEL_GROQ_STANDARD=
AGENT_MODEL_GROQ_HEAVY=

# ── Installation dédiée : passerelle LLM imposée (_shared/llm-upstream.ts) ───
# LLM_UPSTREAM=litellm ou azure envoie tous les appels de chat et d'embeddings
# vers cette passerelle et refuse tout autre hôte (DeepSeek, Groq, Jina…).
LLM_UPSTREAM=
# litellm — la passerelle de la plateforme (docs/openshift-implementation.md D1).
LLM_BASE_URL=
LLM_MODEL_DEFAULT=ops-default
LLM_MODEL_HEAVY=ops-reasoning
LLM_EMBEDDING_MODEL=
LLM_REASONING=
# Clé virtuelle de chaque agent : {"<id ou nom de l'agent>": "sk-…"} ; LLM_API_KEY
# pour les appels sans agent (résumés, interface).
LLM_AGENT_KEYS=
LLM_API_KEY=
# azure — Azure OpenAI en direct, sans passerelle (docs/enterprise-onprem.md).
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_DEPLOYMENT_HEAVY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_REASONING=
# Clé de la ressource, ou principal de service Entra (clés désactivées).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_TENANT_ID=
AZURE_OPENAI_CLIENT_ID=
AZURE_OPENAI_CLIENT_SECRET=
AZURE_OPENAI_SCOPE=
AZURE_AUTHORITY_HOST=
# Hôtes LLM supplémentaires autorisés (un vLLM interne…), séparés par des virgules.
LLM_ALLOWED_HOSTS=

# ── SSO d'entreprise (sso-admin, migrations 0272 et 0282) ───────────────────
# shared (défaut) : chaque organisation configure son SSO pour ses domaines
#   e-mail vérifiés en DNS (TXT _founderos-sso.<domaine>) — le cas du cloud ;
# dedicated : une organisation « maison » gère le SSO de toute l'installation ;
# off : pas de SSO d'entreprise.
SSO_MODE=
# Ancien drapeau : 1 vaut SSO_MODE=dedicated.
SSO_ADMIN_ENABLED=
# ── Administration → Installation (G4) ───────────────────────────────────────
# Adresses e-mail des administrateurs de l'installation, séparées par des
# virgules. Vide : les owners et admins de l'organisation propriétaire, que
# l'owner de la seule organisation d'une instance neuve revendique à l'écran.
# Sur le cloud partagé, renseignez-la : personne ne peut alors revendiquer.
INSTALLATION_ADMINS=
# Résolveur DNS-over-HTTPS (JSON) pour vérifier les domaines. Défaut :
# https://cloudflare-dns.com/dns-query ; un résolveur interne sans sortie Internet.
SSO_DNS_RESOLVER_URL=
# 1 : accepte un issuer ou des métadonnées en http (recette seulement).
SSO_ALLOW_HTTP=

# ── Installation dédiée : appels MCP au nom de la personne et de l'agent ─────
# (docs/openshift-implementation.md D2–D5, D8)
# Repli : la délégation se règle dans Administration → Authentification
# (fournisseur qui délègue, identités des agents ; docs/enterprise-generalisation.md G1).
# Ces variables ne servent que si rien n'y est réglé.
# Keycloak : le realm, et le client confidentiel utilisé par Supabase Auth.
KEYCLOAK_ISSUER=
KEYCLOAK_PORTAL_CLIENT_ID=ai-portal
KEYCLOAK_PORTAL_SECRET=
KEYCLOAK_PROVIDER=custom:keycloak
# Client Keycloak de chaque agent : {"<id ou nom de l'agent>": {"client_id": "…", "client_secret": "…"}}
AGENT_IDP_CLIENTS=
# Catalogue des tools (le même fichier qu'OPA) et OPA pour la pré-décision.
CATALOG_FILE=
OPA_URL=
# Serveurs MCP internes, séparés par des virgules (`*` = un label DNS).
MCP_INTERNAL_HOSTS=
# Certificat client mTLS présenté à ces serveurs, et AC interne.
MCP_CLIENT_CERT_FILE=
MCP_CLIENT_KEY_FILE=
MCP_CA_FILE=

# ── Installation dédiée : approbations des actions en production (D6) ────────
# Émetteur et clé privée P-256 (PKCS#8 PEM) des jetons d'approbation. La clé
# publique est servie par GET /functions/v1/approval-jwks.
APPROVAL_ISSUER=
APPROVAL_SIGNING_KEY=
# Rotation : clés publiques supplémentaires, publiées avant de signer avec ({"keys":[…]}).
APPROVAL_JWKS_EXTRA=
# Facultatif : webhook (Teams, Slack, astreinte) qui prévient les approbateurs.
APPROVAL_NOTIFY_WEBHOOK=

# Recherche et intégrations
JINA_API_KEY=
TAVILY_API_KEY=
COMPOSIO_API_KEY=

# Voix et e-mail
DEEPGRAM_API_KEY=
RESEND_API_KEY=

# Paiement
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FOUNDEROS_STRIPE_SECRET_KEY=
FOUNDEROS_STRIPE_WEBHOOK_SECRET=

# Messageries
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=

# Runners et sandbox
PLATFORM_RUNNER_TOKEN=
RUNNER_URL=
RUNNER_BROWSER_URL=
SANDBOX_URL=
SANDBOX_TOKEN=

# Secrets internes
AGENT_TICK_SECRET=
AGENT_TICK_WALL_MS=
INTERNAL_CRON_SECRET=
WORKFLOW_EVENT_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
