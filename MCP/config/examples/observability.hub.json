{
  "clusters": ["sdb", "npr", "prd", "ips"],
  "observatorium": {
    "url": "https://rbac-query-proxy.open-cluster-management-observability.svc:8443",
    "token": { "type": "kv", "path": "mcp/hub/observability/observatorium", "key": "token" },
    "caFile": "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
    "clusterLabel": "cluster"
  },
  "loki": {
    "url": "https://lokistack-gateway-http.openshift-logging.svc:8080/api/logs/v1/application",
    "token": { "type": "kv", "path": "mcp/hub/observability/loki", "key": "token" },
    "caFile": "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
    "namespaceLabel": "kubernetes_namespace_name",
    "clusterLabel": "openshift_cluster_id",
    "levelMode": "json",
    "levelLabel": "level"
  },
  "apps": {
    "app-a": { "namespace": "app-a-prd", "cluster": "prd" },
    "app-a-npr": { "namespace": "app-a-int", "cluster": "npr" },
    "app-b": { "namespace": "app-b-prd", "cluster": "prd" }
  },
  "alertmanager": {
    "url": "https://alertmanager-operated.open-cluster-management-observability.svc:9095",
    "token": { "type": "kv", "path": "mcp/hub/observability/alertmanager", "key": "token" },
    "caFile": "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
    "clusterLabel": "managed_cluster"
  },
  "grafana": {
    "url": "https://grafana.hub.interne.exemple",
    "token": { "type": "kv", "path": "mcp/hub/observability/grafana", "key": "token" }
  },
  "databases": {
    "orders-pxc": { "engine": "mysql", "selector": "namespace=\"db-orders\"" },
    "catalog-pg": { "engine": "postgresql", "selector": "namespace=\"db-catalog\"" }
  }
}
