{
  "api": {
    "url": "https://kubernetes.default.svc",
    "caFile": "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
  },
  "namespaces": [
    "app-a-prd",
    "app-b-prd"
  ],
  "readCredential": {
    "type": "k8s-token",
    "serviceAccount": "mcp-prd-reader"
  },
  "writeCredential": {
    "type": "k8s-token",
    "serviceAccount": "mcp-prd-operator"
  }
}
