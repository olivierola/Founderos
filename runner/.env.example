# FounderOS Unified Runner — one runner for Ops, E2E tests and security scans.
SUPABASE_URL=https://your-ref.supabase.co

# Global platform runner token (matches PLATFORM_RUNNER_TOKEN on the edge fns,
# or a per-project ops token). One token, one runner, serves everything.
RUNNER_TOKEN=founder_platform_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Needed to stream E2E screenshots to the live view (optional for ops/security).
SUPABASE_SERVICE_ROLE_KEY=

# Optional
RUNNER_ID=
POLL_INTERVAL_MS=3000

# ── Machine tools (runner-mode agents: shell / python / node / files) ──
# Root of the per-agent persistent workspaces (default: ./workspace).
RUNNER_WORKSPACE_ROOT=
# Python binary used by python_exec (default: python on Windows, python3 elsewhere).
PYTHON_BIN=
# Set to 1 to confine file tools to each agent's workspace (blocks absolute paths).
RUNNER_RESTRICT_TO_WORKSPACE=
# Set to 1 to disable shell/code execution entirely (file tools stay available).
RUNNER_DISABLE_EXEC=
