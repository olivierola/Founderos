# URL du projet Supabase FounderOS — la SEULE valeur requise.
SUPABASE_URL=https://scugmxahflsjabglodyv.supabase.co


# Facultatif : sans cette clé, la timeline n'aura pas de vignettes.
SUPABASE_SERVICE_ROLE_KEY=

# L'identité de cet appareil s'obtient par APPAIRAGE au premier démarrage :
# le recorder affiche un code, vous le saisissez dans FounderOS. Rien à copier
# ici. Le jeton obtenu est écrit dans .auth.json.
#
# RUNNER_TOKEN reste accepté pour un déploiement qui utilise déjà le token du
# test-runner, mais il n'est plus nécessaire.
# RUNNER_TOKEN=

# Facultatif
RUNNER_ID=
RECORDER_PROFILE_DIR=./.profile
POLL_INTERVAL_MS=3000
MAX_RECORDING_MIN=45
